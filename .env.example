# ==============================================================================
# ABHISARAN – District Programme Continuity Scan
# Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string (URI)
# Format for connection pooler (transaction mode port 6543) or direct (port 5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Flyway Database Migration
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0

# ------------------------------------------------------------------------------
# Supabase API & Storage Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET_DOCS=abhisaran-documents

# ------------------------------------------------------------------------------
# Spring Boot Backend Service
# ------------------------------------------------------------------------------
SERVER_PORT=8080
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_for_abhisaran_rbac_tokens
JWT_EXPIRATION_MS=86400000

# Security / Zero-PII Safeguards
AUDIT_LOG_RETENTION_DAYS=30
PRIVACY_INCIDENT_ESCALATION_HOURS=2

# ------------------------------------------------------------------------------
# Frontend Application
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# Python FastAPI AI Assistive Service (Read-Only)
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Local Fallback PostgreSQL (Used by docker-compose for offline dev)
LOCAL_POSTGRES_DB=abhisaran
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=postgres
